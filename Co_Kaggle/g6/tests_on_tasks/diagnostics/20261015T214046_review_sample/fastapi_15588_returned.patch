+++ b/verify_sse.py
@@ -0,0 +1,49 @@
+from fastapi.sse import ServerSentEvent
+from pydantic import ValidationError
+import pytest
+
+def test_sse_validation():
+    # Valid event
+    try:
+        ServerSentEvent(event="test-event", id="123")
+        print("✅ Valid event passed")
+    except ValidationError as e:
+        print(f"❌ Valid event failed: {e}")
+
+    # Invalid event (newline)
+    try:
+        ServerSentEvent(event="test\nevent")
+        print("❌ Invalid event (newline) passed")
+    except ValidationError as e:
+        print("✅ Invalid event (newline) failed as expected")
+
+    # Invalid event (carriage return)
+    try:
+        ServerSentEvent(event="test\revent")
+        print("❌ Invalid event (carriage return) passed")
+    except ValidationError as e:
+        print("✅ Invalid event (carriage return) failed as expected")
+
+    # Invalid id (newline)
+    try:
+        ServerSentEvent(id="123\n456")
+        print("❌ Invalid id (newline) passed")
+    except ValidationError as e:
+        print("✅ Invalid id (newline) failed as expected")
+
+    # Invalid id (carriage return)
+    try:
+        ServerSentEvent(id="123\r456")
+        print("❌ Invalid id (carriage return) passed")
+    except ValidationError as e:
+        print("✅ Invalid id (carriage return) failed as expected")
+
+    # Invalid id (null character - existing check)
+    try:
+        ServerSentEvent(id="123\0456")
+        print("❌ Invalid id (null) passed")
+    except ValidationError as e:
+        print("✅ Invalid id (null) failed as expected")
+
+if __name__ == "__main__":
+    test_sse_validation()
