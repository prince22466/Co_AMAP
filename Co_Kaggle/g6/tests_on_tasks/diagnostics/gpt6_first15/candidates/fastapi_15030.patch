@@ -0,0 +1,75 @@
+"""Server-Sent Events response and event representation."""
+from __future__ import annotations
+
+from typing import Any
+
+from pydantic import BaseModel, Field, model_validator
+from starlette.responses import StreamingResponse
+
+
+class EventSourceResponse(StreamingResponse):
+    """Streaming HTTP response carrying text/event-stream events."""
+
+    media_type = "text/event-stream"
+
+    def __init__(self, content: Any, **kwargs: Any) -> None:
+        kwargs.setdefault("media_type", self.media_type)
+        headers = dict(kwargs.pop("headers", None) or {})
+        headers.setdefault("cache-control", "no-cache")
+        headers.setdefault("x-accel-buffering", "no")
+        super().__init__(content, headers=headers, **kwargs)
+
+
+class ServerSentEvent(BaseModel):
+    """One SSE event, with JSON or explicitly raw data."""
+
+    data: Any = None
+    raw_data: str | None = None
+    event: str | None = None
+    id: str | None = None
+    retry: int | None = Field(default=None, ge=0)
+    comment: str | None = None
+
+    @model_validator(mode="after")
+    def validate_fields(self) -> "ServerSentEvent":
+        if self.data is not None and self.raw_data is not None:
+            raise ValueError("Cannot set both 'data' and 'raw_data' on the same ServerSentEvent")
+        for name in ("event", "id"):
+            value = getattr(self, name)
+            if value is not None and ("\r" in value or "\n" in value):
+                raise ValueError(f"SSE {name!r} must be a single line")
+        if self.id is not None and "\0" in self.id:
+            raise ValueError("SSE event id must not contain null characters")
+        return self
+
+
+def format_sse_event(
+    *,
+    data_str: str | None = None,
+    event: str | None = None,
+    id: str | None = None,
+    retry: int | None = None,
+    comment: str | None = None,
+) -> bytes:
+    """Encode one event according to the SSE line-oriented wire format."""
+    for label, value in (("event", event), ("id", id)):
+        if value is not None and ("\r" in value or "\n" in value):
+            raise ValueError(f"SSE {label} must not contain newlines")
+    if id is not None and "\0" in id:
+        raise ValueError("SSE id must not contain null characters")
+    if retry is not None and retry < 0:
+        raise ValueError("SSE retry must be non-negative")
+    lines: list[str] = []
+    if comment is not None:
+        lines.extend(f": {line}" for line in comment.splitlines())
+    if event is not None:
+        lines.append(f"event: {event}")
+    if data_str is not None:
+        lines.extend(f"data: {line}" for line in data_str.splitlines())
+        if not data_str:
+            lines.append("data: ")
+    if id is not None:
+        lines.append(f"id: {id}")
+    if retry is not None:
+        lines.append(f"retry: {retry}")
+    return ("\n".join(lines) + "\n\n").encode("utf-8")
